# Python
__pycache__/
*.pyc *.pyo *.pyd .Python *.egg-info/ dist/ build/
# Environments
.venv/ venv/ env/
# Large model binaries (use Git LFS or cloud storage)
models/trained/*.joblib
models/artifacts/preprocessing_pipeline.joblib
# Keep evaluation results and registry
!models/artifacts/evaluation_results.json
!models/registry/model_registry.json
# Data
data/raw/*.csv
data/processed/ data/features/
# Logs and results
logs/ results/ *.log
# Dev
.ruff_cache/ .pytest_cache/ .coverage coverage.xml htmlcov/
.idea/ .vscode/ *.swp .DS_Store
.ipynb_checkpoints/ *.ipynb
.env .env.* !.env.example
