# ============================================================
# .dockerignore — Keeps Docker build context lean and fast
# ============================================================

# Version control
.git/
.gitignore
.github/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Development tools
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter / notebooks
notebooks/
*.ipynb
.ipynb_checkpoints/

# Docs
README.md
docs/

# Monitoring config (mounted separately in compose)
monitoring/

# Environment files
.env
.env.*
!.env.example

# Large data files (mount as volume at runtime)
data/raw/
data/processed/
data/features/

# Logs (mount as volume)
logs/

# Results
results/

# IDE
.idea/
.vscode/
*.swp

# Scripts
scripts/

# Tests (not needed in production image)
tests/

# Temp
*.tmp
*.bak
tmp/
