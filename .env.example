# ============================================================
# Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── Application ────────────────────────────────────────────
APP_ENV=development           # development | staging | production
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO

# ── API Server ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=true               # Set false in production

# ── Model ──────────────────────────────────────────────────
MODEL_VERSION=v1
DEFAULT_THRESHOLD=0.5         # Overridden by optimized threshold at runtime

# ── Database (optional: for logging predictions) ───────────
# DATABASE_URL=postgresql://user:password@localhost:5432/churn_db
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── Cloud Storage (optional: for remote model artifacts) ───
# AWS
# AWS_ACCESS_KEY_ID=your_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET=your-churn-models-bucket
# S3_MODEL_PREFIX=models/

# GCP
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCS_BUCKET=your-churn-models-bucket

# Azure
# AZURE_STORAGE_CONNECTION_STRING=your_connection_string
# AZURE_CONTAINER_NAME=churn-models

# ── Monitoring ─────────────────────────────────────────────
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_PASSWORD=changeme

# ── Alerting ───────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ALERT_EMAIL=mlops-team@yourcompany.com

# ── MLflow (optional experiment tracking) ──────────────────
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=churn_prediction

# ── Security ───────────────────────────────────────────────
# API_KEY=your_secret_api_key           # For API key auth middleware
# ALLOWED_ORIGINS=https://yourapp.com  # CORS allowed origins
