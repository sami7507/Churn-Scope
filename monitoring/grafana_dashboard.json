{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "Churn Prediction API — Production Monitoring Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "API Health",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{
        "expr": "up{job=\"churn_prediction_api\"}",
        "legendFormat": "Status"
      }],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            {"color": "red", "value": 0},
            {"color": "green", "value": 1}
          ]
        },
        "mappings": [
          {"options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}, "type": "value"}
        ]
      }
    },
    {
      "id": 2,
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"churn_prediction_api\"}[1m])",
          "legendFormat": "{{method}} {{handler}} ({{status}})"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}
      }
    },
    {
      "id": 3,
      "title": "P50 / P95 / P99 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"churn_prediction_api\"}[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"churn_prediction_api\"}[5m]))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"churn_prediction_api\"}[5m]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "title": "5xx Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "targets": [{
        "expr": "rate(http_requests_total{job=\"churn_prediction_api\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"churn_prediction_api\"}[5m])",
        "legendFormat": "5xx Error Rate"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"fixedColor": "red", "mode": "fixed"}}}
    },
    {
      "id": 5,
      "title": "Predicted Churn Rate (Live)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12},
      "targets": [{
        "expr": "rate(churn_predictions_total{prediction=\"1\"}[1h]) / rate(churn_predictions_total[1h])",
        "legendFormat": "Churn Rate"
      }],
      "options": {"colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 6,
      "title": "Total Predictions (24h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 12},
      "targets": [{
        "expr": "increase(churn_predictions_total[24h])",
        "legendFormat": "Predictions"
      }],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ml", "churn", "production"],
  "time": {"from": "now-3h", "to": "now"},
  "title": "Churn Prediction — ML API Dashboard",
  "uid": "churn-prediction-v1",
  "version": 1
}
